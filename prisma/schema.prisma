generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model tw_products {
  skuCode        String   @id
  name           String
  category       String?
  buyPrice       Decimal  @default(0)
  retailPrice    Decimal  @default(0)
  wholesalePrice Decimal  @default(0)
  stock          Decimal  @default(0)
  unit           String?  @default("kg")
  isActive       Boolean  @default(true)
  status         String?  @default("active")
  updated_at     DateTime @default(now()) @db.Timestamptz(6)
}

model tw_sales_history {
  id            String   @id
  date          String?
  items         Json?
  total         Decimal?
  paymentMethod String?
  customerName  String?
  pay           Decimal?
  change        Decimal?
  status        String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}

model tw_customers {
  id         String   @id
  name       String
  phone      String?
  address    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model tw_suppliers {
  id         String   @id
  name       String
  contact    String?
  address    String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
}

model tw_debts {
  id              String   @id
  trxId           String?
  customerName    String?
  amount          Decimal? @default(0)
  paidAmount      Decimal? @default(0)
  remainingAmount Decimal? @default(0)
  date            String?
  status          String?  @default("Belum Lunas")
  created_at      DateTime @default(now()) @db.Timestamptz(6)
}

model tw_finances {
  id          String   @id
  date        String?
  type        String?
  category    String?
  amount      Decimal? @default(0)
  description String?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
}
